---
// Marketing page: all marketing case studies, practice projects, qualifications,
// the work gallery, and other marketing work.
import { getEntry, getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import Gallery from '../components/Gallery.astro';
import Lightbox from '../components/Lightbox.astro';
import Certifications from '../components/Certifications.astro';
import { Image, getImage } from 'astro:assets';
import mockup from '../assets/projects/email-campaign/email-mockup.webp';

const mockupLarge = await getImage({ src: mockup, width: 1250 });
const mockupAlt = 'A marketing email mockup: a brief summary at the top, then the email with a headline, short paragraphs, a list of benefits and a book-a-valuation button.';

const page = (await getEntry('pages', 'marketing'))!;
const { Content } = await render(page);
const practice = await getCollection('projects', (p) => p.data.category === 'practice');
const gallery = await getCollection('gallery');
---
<Base title="Marketing" description={page.data.intro}>
  <p class="label">[ Marketing ]</p>
  <h1 class="mt-2 font-serif text-2xl leading-tight font-semibold sm:text-3xl">{page.data.title}</h1>
  {page.data.intro && <p class="mt-4 max-w-[60ch] text-lg text-muted-foreground">{page.data.intro}</p>}

  {gallery.length > 0 && (
    <section aria-labelledby="work" class="mt-8 scroll-mt-20" id="gallery">
      <h2 id="work" class="label">[ Work gallery ]</h2>
      <p class="mt-1 text-sm text-muted-foreground">Click any image to see it larger. Faces and personal details are blurred or replaced.</p>
      <div class="mt-4"><Gallery /></div>
    </section>
  )}

  <section aria-labelledby="projects" class="section-rule">
    <h2 id="projects" class="label">[ Case studies ]</h2>
    <div class="mt-3"><ProjectList category="marketing" /></div>
  </section>

  {practice.length > 0 && (
    <section aria-labelledby="practice" class="mt-14">
      <h2 id="practice" class="label">[ Practice projects ]</h2>
      <p class="mt-1 text-sm text-muted-foreground">Independent practice, not commissioned or affiliated.</p>
      <div class="mt-3"><ProjectList category="practice" /></div>
    </section>
  )}

  <div class="prose-site max-w-3xl">
    <Content />
  </div>

  <figure class="mt-4 max-w-sm">
    <button
      type="button"
      class="lightbox-trigger email-mockup"
      data-lightbox-src={mockupLarge.src}
      data-lightbox-alt={mockupAlt}
      data-lightbox-caption="Email campaign mockup made for a job application. Not BlayCare work."
      data-lightbox-note="Personal details and sensitive content replaced for portfolio display."
      aria-label={`Enlarge image: ${mockupAlt}`}
    >
      <Image src={mockup} alt={mockupAlt} width={640} loading="lazy" class="email-mockup-img" />
    </button>
    <figcaption class="mt-2 text-sm text-muted-foreground">Email campaign mockup for a job application, not BlayCare work. Click to see the whole email.</figcaption>
  </figure>

  <Certifications />

  <Lightbox />
</Base>

<style>
  /* Show just the top of the tall email as a small preview; the full email opens in the lightbox. */
  .email-mockup {
    display: block;
    width: 100%;
    height: 14rem;
    overflow: hidden;
    border: 1px solid var(--site-line);
  }
  .email-mockup :global(.email-mockup-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
</style>
