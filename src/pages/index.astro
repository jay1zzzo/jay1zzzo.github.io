---
// Home page. All the words come from src/content/home.md and src/content/projects/.
import { getEntry, getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard';
import IntroToggle from '../components/IntroToggle';
import { buttonVariants } from '@/components/ui/button';

const home = (await getEntry('home', 'home'))!.data;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base>
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-12">
    <!-- Left: headline, intro, contact -->
    <section aria-labelledby="headline">
      <h1 id="headline" class="max-w-[26ch] font-serif text-[2rem] leading-[1.1] font-semibold sm:text-5xl lg:text-[2.875rem]">
        {home.headline}
      </h1>

      <div class="mt-5">
        <IntroToggle client:load short={home.shortIntro} long={home.longIntro} />
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
        <a href={`mailto:${home.email}`} class={buttonVariants({ size: 'lg' }) + ' px-4'}>
          {home.contactButton}
        </a>
        <a
          href={home.linkedin}
          rel="noopener"
          class="font-mono text-xs tracking-wider text-muted-foreground uppercase underline-offset-4 hover:text-primary hover:underline"
        >
          LinkedIn
        </a>
      </div>
    </section>

    <!-- Right: what I believe -->
    <section aria-labelledby="beliefs" class="self-start border-2 border-border bg-card p-5">
      <h2 id="beliefs" class="label">[ What I believe ]</h2>
      <ol class="mt-3 space-y-2.5">
        {home.beliefs.map((belief, i) => (
          <li class="flex gap-3 text-sm leading-snug">
            <span class="font-mono text-xs text-primary" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span>{belief}</span>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <!-- Project cards -->
  <section aria-labelledby="work" class="mt-8">
    <h2 id="work" class="label">[ Selected work ]</h2>
    <div class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => (
        <ProjectCard
          client:visible
          label={p.data.label}
          title={p.data.title}
          summary={p.data.summary}
          href={`/projects/${p.id}`}
        />
      ))}
    </div>
  </section>
</Base>
