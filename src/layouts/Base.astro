---
// The frame around every page: header, navigation and footer.
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

interface Props {
  title?: string;        // e.g. "Tools" → browser tab says "Tools | Jason Belgica Paguntalan"
  description?: string;
}

const siteName = 'Jason Belgica Paguntalan';
const linkedIn = 'https://www.linkedin.com/in/jason-belgica';
const { title, description = 'Marketing Assistant who builds small tools to make work easier.' } = Astro.props;
const pageTitle = title ? `${title} | ${siteName}` : siteName;

const nav = [
  { label: 'Marketing', href: '/marketing' },
  { label: 'Tools', href: '/tools' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
const current = Astro.url.pathname.replace(/\/$/, '');
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="site-name" href="/">{siteName}</a>
        <nav aria-label="Main">
          <ul class="nav-list">
            {nav.map((item) => (
              <li>
                <a
                  class="nav-link"
                  href={item.href}
                  aria-current={current === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© {year} {siteName}</span>
        <a href={linkedIn} rel="noopener">LinkedIn</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    border-bottom: var(--border-width) solid var(--site-line);
  }
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  .site-name {
    font-family: var(--site-serif);
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
  }
  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-link {
    display: inline-block;
    padding: 0.5rem 0; /* bigger tap area on phones */
    font-family: var(--site-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--site-muted);
    border-bottom: var(--border-width) solid transparent;
    transition: color 120ms, border-color 120ms;
  }
  .nav-link:hover {
    color: var(--site-text);
  }
  .nav-link[aria-current='page'] {
    color: var(--site-text);
    border-bottom-color: var(--site-accent);
  }

  main {
    padding-top: 2rem;
    padding-bottom: 3rem;
  }

  .site-footer {
    border-top: var(--border-width) solid var(--site-line);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
    font-family: var(--site-mono);
    font-size: 0.75rem;
    color: var(--site-muted);
  }
  .footer-inner a {
    display: inline-block;
    padding: 0.25rem 0; /* bigger tap area on phones */
    color: var(--site-muted);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .footer-inner a:hover {
    color: var(--site-accent);
  }
</style>
