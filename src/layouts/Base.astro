---
// The frame around every page: header, navigation and footer.
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import { analytics } from '../analytics';

interface Props {
  title?: string;        // e.g. "Tools" → browser tab says "Tools | Jason Belgica Paguntalan"
  description?: string;
}

const siteName = 'Jason Belgica Paguntalan';
const linkedIn = 'https://www.linkedin.com/in/jason-belgica';
const { title, description = 'Junior marketer in the East Midlands with a Level 3 Multichannel Marketer qualification.' } = Astro.props;
const pageTitle = title ? `${title} | ${siteName}` : siteName;

const nav = [
  { label: 'Marketing', href: '/marketing' },
  { label: 'Tools', href: '/tools' },
  // To bring the About link back, remove the two slashes in front of the next line.
  // { label: 'About', href: '/#about' },
  { label: 'Contact', href: '/#contact' },
];
const current = Astro.url.pathname.replace(/\/$/, '');
// A small Home link at the top of inner pages (project pages have their own back link).
const showHome = current !== '' && !current.startsWith('/projects');
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <!-- Hidden from search engines for now. Delete this line when you are ready to be found. -->
    <meta name="robots" content="noindex, nofollow" />
    <!-- Sets the colour theme before the page paints, so there is no flash. -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', t);
        // Gentle motion (smooth scrolling and fade-ins) only for visitors who have not asked for reduced motion.
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
      })();
    </script>
    {analytics.websiteId && (
      <>
        <!-- Skips your own visits: open any page of the site with ?notrack once on a device (and ?track to switch counting back on). -->
        <script is:inline>
          (function () {
            try {
              var q = location.search;
              if (q.indexOf('notrack') > -1) localStorage.setItem('notrack', '1');
              if (q.indexOf('track') > -1 && q.indexOf('notrack') === -1) localStorage.removeItem('notrack');
            } catch (e) {}
          })();
          function umamiBeforeSend(type, payload) {
            try { if (localStorage.getItem('notrack') === '1') return false; } catch (e) {}
            return payload;
          }
        </script>
        <script
          is:inline
          defer
          src={analytics.scriptSrc}
          data-website-id={analytics.websiteId}
          data-domains={analytics.domain}
          data-exclude-search="true"
          data-do-not-track="true"
          data-before-send="umamiBeforeSend"
        ></script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <!-- No header bar: the menu and the light/dark switch live in the footer.
         Inner pages get a small Home link at the top instead. -->

    <main id="main" class="container">
      {showHome && <a href="/" class="back-home"><span aria-hidden="true">←</span> Home</a>}
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© {year} {siteName}{analytics.websiteId && ' · Privacy-friendly visitor statistics, no cookies.'}</span>
        <div class="footer-right">
        <nav aria-label="Main">
          <ul class="nav-list">
            {nav.map((item) => (
              <li>
                <a
                  class="nav-link"
                  href={item.href}
                  aria-current={current === item.href ? 'page' : undefined}
                  data-umami-event="Menu click"
                  data-umami-event-page={item.label}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <button type="button" id="theme-toggle" class="theme-toggle" role="switch" aria-checked="true" aria-label="Dark mode">
          <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" fill="currentColor"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1"/></g></svg>
          <span class="theme-label" aria-hidden="true">Dark</span>
        </button>
        <a href={linkedIn} rel="noopener" data-umami-event="LinkedIn click" data-umami-event-where="Footer">LinkedIn</a>
        </div>
      </div>
    </footer>
    <script>
      // Smooth scrolling (Lenis) and gentle fade-ins as sections come into view.
      // Both are off for visitors who prefer reduced motion (no "motion" class on <html>).
      import Lenis from 'lenis';
      const html = document.documentElement;
      if (html.classList.contains('motion')) {
        const lenis = new Lenis({ autoRaf: true, anchors: { offset: -16 }, lerp: 0.09 });

        // Sections fade in and lift slightly; cards in a grid follow one after another.
        const targets: HTMLElement[] = [];
        document.querySelectorAll<HTMLElement>('main > section, main > div, main > figure').forEach((el) => {
          el.setAttribute('data-reveal', '');
          targets.push(el);
        });
        document.querySelectorAll<HTMLElement>('[data-reveal-group]').forEach((group) => {
          group.querySelectorAll<HTMLElement>(':scope > :not(style):not(script)').forEach((el, i) => {
            el.setAttribute('data-reveal', '');
            el.style.setProperty('--d', `${Math.min(i, 4) * 80}ms`);
            targets.push(el);
          });
        });
        // Show anything that has come into view. Checked on load and on every scroll.
        let pending = targets;
        const check = () => {
          const line = window.innerHeight * 0.94;
          pending = pending.filter((el) => {
            if (el.getBoundingClientRect().top < line) {
              el.classList.add('in');
              return false;
            }
            return true;
          });
        };
        check();
        lenis.on('scroll', check);
        window.addEventListener('scroll', check, { passive: true });
        window.addEventListener('resize', check);
        // Safety net: if the page jumps straight to a section (a link with #), show everything above it too.
        window.addEventListener('load', check);
      }

      // Theme toggle: remembers an explicit choice, and follows the device until then.
      const root = document.documentElement;
      const btn = document.getElementById('theme-toggle');
      const label = btn?.querySelector('.theme-label');
      const mq = window.matchMedia('(prefers-color-scheme: light)');
      const apply = (t: string) => {
        root.setAttribute('data-theme', t);
        btn?.setAttribute('aria-checked', String(t === 'dark'));
        if (label) label.textContent = t === 'dark' ? 'Dark' : 'Light';
      };
      apply(root.getAttribute('data-theme') === 'light' ? 'light' : 'dark');
      btn?.addEventListener('click', () => {
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        apply(next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
      mq.addEventListener('change', (e) => {
        let saved: string | null = null;
        try { saved = localStorage.getItem('theme'); } catch (err) {}
        if (saved !== 'light' && saved !== 'dark') apply(e.matches ? 'light' : 'dark');
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: var(--border-width) solid var(--site-line);
  }
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  .site-name {
    font-family: var(--site-serif);
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
  }
  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* On phones: name and theme switch share the first row, navigation sits below */
  @media (max-width: 40rem) {
    .site-name { order: 1; }
    .theme-toggle { order: 2; margin-left: auto; }
    .header-inner > nav { order: 3; flex-basis: 100%; }
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    padding: 0.25rem 0.75rem;
    font-family: var(--site-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--site-text);
    background: transparent;
    border: var(--border-width) solid var(--site-line);
    border-radius: var(--radius);
    cursor: pointer;
    transition: border-color 120ms, color 120ms;
  }
  .theme-toggle:hover {
    border-color: var(--site-accent);
    color: var(--site-accent);
  }
  :global(html[data-theme='light']) .icon-moon,
  :global(html:not([data-theme='light'])) .icon-sun {
    display: none;
  }
  .nav-link {
    display: inline-block;
    padding: 0.5rem 0; /* bigger tap area on phones */
    font-family: var(--site-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--site-muted);
    border-bottom: var(--border-width) solid transparent;
    transition: color 120ms, border-color 120ms;
  }
  .nav-link:hover {
    color: var(--site-text);
  }
  .nav-link[aria-current='page'] {
    color: var(--site-text);
    border-bottom-color: var(--site-accent);
  }

  main {
    padding-top: 2rem;
    padding-bottom: 3rem;
  }

  .site-footer {
    border-top: var(--border-width) solid var(--site-line);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
    font-family: var(--site-mono);
    font-size: 0.75rem;
    color: var(--site-muted);
  }
  .footer-inner a {
    display: inline-block;
    padding: 0.25rem 0; /* bigger tap area on phones */
    color: var(--site-muted);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .footer-inner a:hover {
    color: var(--site-accent);
  }
  .footer-inner {
    align-items: center;
  }
  .footer-right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
  }
  .back-home {
    display: inline-block;
    margin-bottom: 1.5rem;
    padding: 0.5rem 0;
    font-family: var(--site-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--site-muted);
    text-decoration: none;
  }
  .back-home:hover {
    color: var(--site-accent);
  }
</style>
