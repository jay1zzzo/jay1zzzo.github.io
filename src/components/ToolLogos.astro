---
// Tools & Technologies: a grid of app logos, grouped by category.
// The list lives in src/content/home.md under "tools:".
// Logo files live in src/assets/tools/ and are served as plain images
// (no JavaScript). Apps without a logo show a lettered tile.
import type { ImageMetadata } from 'astro';

interface Tool {
  name: string;
  logo?: string;
  group?: string;
  chip?: boolean; // white logo: show on a dark tile in both themes
  note?: string;  // e.g. "basic experience"
}
interface Props {
  title?: string;
  subtitle?: string;
  tools: Tool[];
}
const { title = 'Tools & Technologies', subtitle, tools } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/tools/*.{svg,png,webp}', { eager: true });

// Keep groups in the order they first appear in home.md
const groups: { name: string; items: (Tool & { src?: string })[] }[] = [];
for (const t of tools) {
  const g = t.group ?? '';
  let entry = groups.find((x) => x.name === g);
  if (!entry) groups.push((entry = { name: g, items: [] }));
  let src: string | undefined;
  if (t.logo) {
    const f = files[`/src/assets/tools/${t.logo}`];
    if (!f) throw new Error(`Tools: can't find "${t.logo}" in src/assets/tools/. Check the file name in home.md.`);
    src = f.default.src;
  }
  entry.items.push({ ...t, src });
}
---
<section aria-labelledby="tools-heading" class="mt-14">
  <h2 id="tools-heading" class="label">[ {title} ]</h2>
  {subtitle && <p class="mt-1 text-sm text-muted-foreground">{subtitle}<span class="hover-hint"> Hover a logo for its name.</span></p>}

  <div class="mt-5 grid gap-6">
    {groups.map((g) => (
      <div class="md:grid md:grid-cols-[11rem_minmax(0,1fr)] md:items-start md:gap-6">
        {g.name && <h3 class="tools-group">{g.name}</h3>}
        <ul class="tools-grid">
          {g.items.map((t) => (
            <li class="tool-tile">
              {t.src ? (
                <img src={t.src} alt="" width="32" height="32" loading="lazy" decoding="async" class={t.chip ? 'tool-logo tool-chip' : 'tool-logo'} />
              ) : (
                <span class="tool-initial" aria-hidden="true">{t.name.charAt(0)}</span>
              )}
              <span class="tool-name">{t.note ? `${t.name} · ${t.note}` : t.name}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .tools-group {
    margin-bottom: 0.75rem;
    padding-top: 0.25rem;
    font-family: var(--site-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--site-accent);
  }
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5rem, 1fr));
    gap: 0.25rem 0.5rem;
  }
  .hover-hint {
    display: none;
  }
  @media (hover: hover) {
    /* Snug square boxes: the amber outline hugs the logo, with no extra space */
    .tools-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 0.75rem;
      /* Left-aligned rows: 8, 6, 4, 4, 2 make a neat staircase next to the labels */
      justify-content: flex-start;
    }
    .hover-hint {
      display: inline;
    }
  }
  /* Borderless and quiet. Muted until hovered, then a thin amber outline. */
  .tool-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0.4rem;
    padding: 0.625rem 0.3rem 0.5rem;
    text-align: center;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: transparent;
    opacity: 0.72;
    transition: transform 180ms ease, opacity 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }
  .tool-tile:hover {
    opacity: 1;
    transform: scale(1.06);
    border-color: var(--site-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--site-accent) 18%, transparent);
  }
  .tool-logo,
  .tool-initial {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }
  .tool-initial {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--site-muted);
    border-radius: var(--radius);
    font-family: var(--site-serif);
    font-size: 1rem;
    font-weight: 600;
    color: var(--site-text);
  }
  .tool-chip {
    padding: 3px;
    background: var(--site-chip);
    border-radius: var(--radius);
  }
  .tool-name {
    font-family: var(--site-mono);
    font-size: 0.6875rem;
    line-height: 1.35;
    letter-spacing: 0.03em;
    color: var(--site-text);
  }
  /* On screens with a mouse the name is a small quiet label that fades in on hover.
     It stays in the page for screen readers. Touch screens keep the names showing. */
  @media (hover: hover) {
    .tool-tile {
      position: relative;
      width: 3rem;
      height: 3rem;
      padding: 0;
      justify-content: center;
    }
    .tool-name {
      position: absolute;
      bottom: calc(100% - 0.25rem);
      left: 50%;
      z-index: 5;
      padding: 0.2rem 0.5rem;
      white-space: nowrap;
      pointer-events: none;
      background: var(--site-card);
      border: 1px solid var(--site-line);
      border-radius: var(--radius);
      opacity: 0;
      transform: translateX(-50%) translateY(3px);
      transition: opacity 160ms ease, transform 160ms ease;
    }
    .tool-tile:hover .tool-name {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: reduce) {
    .tool-name {
      transform: translateX(-50%);
      transition: opacity 160ms ease;
    }
    .tool-tile:hover .tool-name {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tool-tile,
    .tool-tile:hover {
      transform: none;
      transition: opacity 180ms ease;
    }
  }
  /* Touch screens have no hover, so show tools at full strength there. */
  @media (hover: none) {
    .tool-tile {
      opacity: 1;
    }
  }
</style>
