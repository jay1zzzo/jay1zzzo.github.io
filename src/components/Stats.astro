---
// Row of number boxes. The numbers are shown immediately, with no animation.
interface Stat {
  value: number | string;
  suffix?: string;
  label: string;
}
interface Props {
  title?: string;
  stats: Stat[];
}
const { title = 'In numbers', stats } = Astro.props;
---
<section aria-label={title} class="mt-8">
  <h2 class="section-title">{title}</h2>
  <dl class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3">
    {stats.map((s) => (
      <div class="border-2 border-border bg-card p-4">
        <dt class="mt-2 text-sm text-muted-foreground">{s.label}</dt>
        <dd class="font-serif text-2xl leading-none font-semibold text-primary">
          {typeof s.value === 'number' ? (
            <span>{s.value}{s.suffix}</span>
          ) : (
            <span>{s.value}</span>
          )}
        </dd>
      </div>
    ))}
  </dl>
</section>

<style>
  /* The label (dt) comes first in the code, as it should; this shows it under the number */
  div { display: flex; flex-direction: column-reverse; justify-content: flex-end; }
</style>
