---
// One grouped section: the tool logos on the left, and the qualification and certificates
// on the right as short "X by Y" lines. Reads home.md (tools) and certifications.yaml.
// Certificate images and codes are never shown, only the words.
import { getCollection } from 'astro:content';
import ToolLogos from './ToolLogos.astro';

interface Props {
  tools: { name: string; logo?: string; group?: string; chip?: boolean; note?: string }[];
  toolsTitle?: string;
}
const { tools, toolsTitle = 'Tools I have used' } = Astro.props;

const all = (await getCollection('certifications')).sort((a, b) => a.data.order - b.data.order);
// Items that have a provider read as "Name by Provider"; the rest become quiet tags.
const lines = [
  ...all.filter((c) => c.data.provider && c.data.type === 'education'),
  ...all.filter((c) => c.data.provider && c.data.type !== 'education'),
];
const also = all.filter((c) => !c.data.provider);
---
<section aria-labelledby="skills-heading" class="section-rule">
  <h2 id="skills-heading" class="section-title">Tools and qualifications</h2>

  <div class="mt-5 grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-12">
    <ToolLogos embedded title={toolsTitle} tools={tools} />

    <div>
      <h3 class="label">Qualified and certified</h3>
      <ul class="mt-4 grid gap-3">
        {lines.map((c) => (
          <li class="flex items-start gap-3 text-[0.9375rem] leading-snug">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true" focusable="false" class="mt-px shrink-0 text-primary">
              <circle cx="12" cy="12" r="8.5" />
              <path d="M8.5 12.25l2.5 2.5 4.5-5" />
            </svg>
            <span>
              <span class="font-medium">{c.data.name}</span>
              <span class="text-muted-foreground"> by {c.data.provider}</span>
            </span>
          </li>
        ))}
      </ul>

      {also.length > 0 && (
        <>
          <h3 class="label mt-8">Also</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {also.map((c) => (
              <li class="max-w-full border border-border bg-card px-3 py-1.5 text-sm leading-snug transition-colors duration-200 hover:border-primary/50">{c.data.name}</li>
            ))}
          </ul>
        </>
      )}
    </div>
  </div>
</section>
