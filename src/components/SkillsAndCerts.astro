---
// Skills & CERTIFICATIONS: light tiles with each tool's logo and name, and the qualification
// and certificates as "Name certification by Provider" lines with a badge icon.
// Reads home.md (tools) and certifications.yaml. Certificate images and codes are never shown.
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import TwoStyle from './TwoStyle.astro';

interface Tool {
  name: string;
  logo?: string;
  group?: string;
  chip?: boolean; // white logo: shown on a small dark square so it stays visible
  note?: string;
}
interface Props {
  tools: Tool[];
  toolsTitle?: string;
}
const { tools } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/tools/*.{svg,png,webp}', { eager: true });
const tiles = tools.map((t) => ({ ...t, src: t.logo ? files[`/src/assets/tools/${t.logo}`]?.default.src : undefined }));

const all = (await getCollection('certifications')).sort((a, b) => a.data.order - b.data.order);
// Main lines: the qualification first, then the certificates.
const lines = [
  ...all.filter((c) => c.data.provider && c.data.type === 'education'),
  ...all.filter((c) => c.data.provider && c.data.type !== 'education'),
].map((c) => {
  const isQual = c.data.type === 'education';
  const name = c.data.name.replace(/\s+Certified$/i, '');
  const kind = isQual ? 'qualification' : 'Certification';
  const provider = (c.data.provider ?? '').replace(/\s+Academy$/i, '');
  return { name, kind, provider };
});
const also = all.filter((c) => !c.data.provider);

// Certificate pictures (web copies made in the private folder, with the certificate number
// and certification codes blurred). The apprenticeship certificate is tall, so it sits on the left.
const certFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/certificates/*.webp', { eager: true });
const cert = async (file: string, alt: string, caption: string) => {
  const src = certFiles[`/src/assets/certificates/${file}`]?.default;
  if (!src) return undefined;
  return { src, alt, caption, large: (await getImage({ src, width: 1400 })).src };
};
const certs = (
  await Promise.all([
    cert('level-3-apprenticeship.webp', 'Apprenticeship certificate of achievement: Jason Paguntalan has passed the Multi-Channel Marketer Level 3 apprenticeship, grade Pass, awarded 19 October 2026.', 'Level 3 Multi-Channel Marketer apprenticeship, Pass, October 2026.'),
    cert('hubspot-seo.webp', 'HubSpot Academy certificate: SEO Certified, valid from 19 April 2026 to 19 May 2027.', 'HubSpot Academy, SEO Certified.'),
    cert('hubspot-social-media.webp', 'HubSpot Academy certificate: Social Media Certified, valid from 7 July 2025 to 6 August 2027.', 'HubSpot Academy, Social Media Certified.'),
  ])
).filter((c) => c !== undefined);
const CERT_NOTE = 'Certificate number and certification code blurred for portfolio display.';
---
<section aria-labelledby="skills-heading" class="section-rule">
  <h2 id="skills-heading" class="big-title"><TwoStyle text="Skills & certifications" /></h2>

  <div class="skills-grid">
    <ul class="tool-tiles" aria-label="Tools I have used">
      {tiles.map((t) => (
        <li class="tool-tile2" title={t.note ? `${t.name} · ${t.note}` : t.name}>
          {t.src ? (
            <span class={t.chip ? 'tile-logo tile-chip' : 'tile-logo'}><img src={t.src} alt="" width="24" height="24" loading="lazy" decoding="async" /></span>
          ) : (
            <span class="tile-logo tile-initial" aria-hidden="true">{t.name.charAt(0)}</span>
          )}
          <span class="tile-name">{t.name}</span>
        </li>
      ))}
    </ul>

    <div>
      {certs.length > 0 && (
        <ul class="cert-pics" aria-label="Certificates">
          {certs.map((c, i) => (
            <li class={i === 0 ? 'cert-pic cert-pic-tall' : 'cert-pic'}>
              <button
                type="button"
                class="lightbox-trigger"
                data-lightbox-src={c.large}
                data-lightbox-alt={c.alt}
                data-lightbox-caption={c.caption}
                data-lightbox-note={CERT_NOTE}
                aria-label={`Enlarge certificate: ${c.caption}`}
              >
                <Image src={c.src} alt={c.alt} width={700} sizes="(min-width: 1024px) 18rem, 50vw" loading="lazy" />
              </button>
            </li>
          ))}
        </ul>
      )}
      <ul class="cert-lines">
        {lines.map((l) => (
          <li>
            <svg class="rosette" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
              <path d="M12 2.5l1.9 1.4 2.3-.3 1 2.1 2.1 1-.3 2.3 1.4 1.9-1.4 1.9.3 2.3-2.1 1-1 2.1-2.3-.3L12 19.3l-1.9-1.4-2.3.3-1-2.1-2.1-1 .3-2.3-1.4-1.9 1.4-1.9-.3-2.3 2.1-1 1-2.1 2.3.3z" />
              <path d="M8.8 11l2.2 2.2 4.2-4.4" />
              <path d="M9 18.5l-1.2 3.3 2.2-.9 1 2 1-3.5M15 18.5l1.2 3.3-2.2-.9-1 2" />
            </svg>
            <span><strong>{l.name}</strong> {l.kind} by {l.provider}</span>
          </li>
        ))}
      </ul>

      {also.length > 0 && (
        <>
          <h3 class="label mt-8">Courses and education</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {also.map((c) => (
              <li class="max-w-full border border-border px-3 py-1.5 text-sm leading-snug">{c.data.name}</li>
            ))}
          </ul>
        </>
      )}
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    gap: 2.5rem;
    margin-top: 2rem;
  }
  @media (min-width: 1024px) {
    .skills-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 3.5rem;
      align-items: start;
    }
  }
  .tool-tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 0.5rem;
  }
  .tool-tile2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3.25rem;
    padding: 0.5rem 0.75rem;
    background: #ecebe7;
    color: #1f2226;
    border-radius: 6px;
    transition: transform 200ms ease;
  }
  .tool-tile2:hover {
    transform: translateY(-2px);
  }
  .tile-logo {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
  }
  .tile-logo img {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }
  .tile-chip {
    background: #2b2e33;
    border-radius: 5px;
  }
  .tile-chip img {
    width: 18px;
    height: 18px;
  }
  .tile-initial {
    border: 1.5px solid #8a8f96;
    border-radius: 5px;
    font-family: var(--site-serif);
    font-weight: 700;
    font-size: 0.875rem;
  }
  .tile-name {
    font-family: var(--site-serif);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .cert-pics {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    grid-template-rows: auto auto;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  .cert-pic-tall {
    grid-row: 1 / span 2;
  }
  .cert-pic :global(.lightbox-trigger) {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    background: #fff;
    border-radius: 4px;
    overflow: hidden;
    cursor: zoom-in;
  }
  .cert-pic :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 400ms ease;
  }
  .cert-pic:hover :global(img) {
    transform: scale(1.03);
  }
  .cert-lines {
    display: grid;
    gap: 1.1rem;
  }
  .cert-lines li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 1.0625rem;
    line-height: 1.35;
    color: var(--site-muted);
  }
  .cert-lines strong {
    font-weight: 700;
    color: var(--site-text);
  }
  .rosette {
    flex: none;
    color: var(--site-text);
  }
  @media (prefers-reduced-motion: reduce) {
    .tool-tile2:hover {
      transform: none;
    }
  }
</style>
