---
// "Learning and in progress": compact tags for what I am working on now.
// Reads the homeLearning list in src/content/home.md. Hidden if empty.
interface Item {
  name: string;
  note?: string;
}
interface Props {
  title?: string;
  items: Item[];
}
const { title = 'Learning and in progress', items } = Astro.props;
---
{items.length > 0 && (
  <section aria-labelledby="learning-heading" class="mt-12">
    <h2 id="learning-heading" class="label">[ {title} ]</h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      {items.map((i) => (
        <li class="border-2 border-border bg-card px-3 py-1.5 text-sm">
          <span class="font-mono text-xs tracking-wide">{i.name}</span>
          {i.note && <span class="ml-2 text-xs text-muted-foreground">{i.note}</span>}
        </li>
      ))}
    </ul>
  </section>
)}
