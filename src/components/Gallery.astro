---
// Work gallery: a sideways-scrolling strip of work. Reads src/content/gallery.yaml.
// Images come from src/assets/gallery/ or src/assets/work/ (the yaml says which).
// Click any image to enlarge it (needs <Lightbox /> on the same page).
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  limit?: number; // show only the first N items
}
const { limit } = Astro.props;

const EDITED_NOTE = 'Personal details and sensitive content replaced for portfolio display.';

const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/{gallery,work}/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

const all = await getCollection('gallery');
const items = await Promise.all(
  all.slice(0, limit ?? all.length).map(async ({ data }) => {
    const file = files[`/src/assets/${data.image}`];
    if (!file) {
      throw new Error(`Gallery: can't find "${data.image}" in src/assets/. Use the form "work/file.webp" or "gallery/file.png" in gallery.yaml.`);
    }
    const large = await getImage({ src: file.default, width: 1600 });
    return { ...data, src: file.default, large: large.src };
  }),
);
---
<div class="gallery">
  <div class="gallery-bar">
    <span class="gallery-arrows">
      <button type="button" class="gallery-arrow" data-gallery-prev aria-label="Scroll the gallery left">←</button>
      <button type="button" class="gallery-arrow" data-gallery-next aria-label="Scroll the gallery right">→</button>
    </span>
  </div>
  <ul class="gallery-strip" tabindex="0" aria-label="Work gallery, scrolls sideways">
    {items.map((item) => (
      <li class="gallery-item">
        <button
          type="button"
          class="lightbox-trigger"
          data-lightbox-src={item.large}
          data-lightbox-alt={item.alt}
          data-lightbox-caption={[item.what, item.did].map((t) => t.replace(/[.\s]+$/, '')).join('. ') + '.' + (item.tool ? ' Tool: ' + item.tool.replace(/[.\s]+$/, '') + '.' : '')}
          data-lightbox-note={item.edited ? EDITED_NOTE : ''}
          aria-label={`Enlarge image: ${item.alt}`}
        >
          <Image src={item.src} alt={item.alt} width={560} loading="lazy" />
        </button>
        <p class="gallery-title">{item.what}</p>
        {item.tool && <p class="label gallery-tool">{item.tool}</p>}
      </li>
    ))}
  </ul>
</div>

<style>
  .gallery-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .gallery-hint {
    font-size: 0.8125rem;
    color: var(--site-muted);
  }
  .gallery-arrows {
    display: inline-flex;
    gap: 0.375rem;
  }
  .gallery-arrow {
    min-width: 2.5rem;
    min-height: 2.25rem;
    font-family: var(--site-mono);
    font-size: 0.875rem;
    color: var(--site-text);
    background: transparent;
    border: 1px solid var(--site-line);
    border-radius: var(--radius);
    cursor: pointer;
    transition: border-color 150ms, color 150ms;
  }
  .gallery-arrow:hover {
    color: var(--site-accent);
    border-color: var(--site-accent);
  }
  .gallery-strip {
    display: flex;
    gap: 1rem;
    padding-bottom: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-padding-inline: 0;
    scrollbar-width: thin;
    scrollbar-color: var(--site-line) transparent;
  }
  .gallery-strip:focus-visible {
    outline: 2px solid var(--site-accent);
    outline-offset: 4px;
  }
  .gallery-item {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }
  /* A fixed height, with the width worked out from each piece's real proportions,
     so nothing is stretched, squeezed or cropped. */
  .gallery-item :global(.lightbox-trigger) {
    display: block;
    width: auto;
  }
  .gallery-item :global(img) {
    display: block;
    width: auto;
    height: 16rem;
    max-width: none;
  }
  .gallery-title,
  .gallery-tool {
    /* width 0 + min-width 100% lets long text wrap under the image
       without making the item wider than its picture */
    width: 0;
    min-width: 100%;
  }
  .gallery-title {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .gallery-tool {
    margin-top: 0.125rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .gallery-strip {
      scroll-behavior: smooth;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.gallery').forEach((g) => {
    const strip = g.querySelector<HTMLElement>('.gallery-strip');
    if (!strip) return;
    const step = (dir: number) => strip.scrollBy({ left: dir * Math.round(strip.clientWidth * 0.8) });
    const count = (direction: string) => (window as any).umami?.track?.('Gallery arrow', { direction });
    g.querySelector('[data-gallery-prev]')?.addEventListener('click', () => { step(-1); count('left'); });
    g.querySelector('[data-gallery-next]')?.addEventListener('click', () => { step(1); count('right'); });
  });
</script>
