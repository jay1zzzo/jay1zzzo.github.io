---
// The click-to-enlarge window. Put <Lightbox /> once on any page that has
// enlargeable images. Any button with data-lightbox-src opens it.
---
<dialog id="lightbox" class="lightbox" aria-label="Enlarged image">
  <button type="button" class="lightbox-close" data-lightbox-close>
    Close <span aria-hidden="true">×</span>
  </button>
  <img id="lightbox-img" alt="" />
  <p id="lightbox-caption" class="lightbox-caption"></p>
</dialog>

<style is:global>
  .lightbox {
    max-width: min(92vw, 70rem);
    max-height: 92vh;
    margin: auto;
    padding: 0;
    background: var(--site-card);
    color: var(--site-text);
    border: var(--border-width) solid var(--site-accent);
    border-radius: var(--radius);
  }
  .lightbox::backdrop {
    background: rgb(14 17 22 / 0.88);
  }
  .lightbox img {
    display: block;
    width: auto;
    height: auto;
    max-width: min(88vw, 68rem);
    max-height: calc(92vh - 6rem);
    margin: 0 auto;
    object-fit: contain;
  }
  .lightbox-close {
    display: block;
    margin-left: auto;
    padding: 0.5rem 0.75rem;
    font-family: var(--site-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--site-text);
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .lightbox-close:hover {
    color: var(--site-accent);
  }
  .lightbox-caption {
    padding: 0.75rem 1rem 1rem;
    font-size: 0.875rem;
    color: var(--site-muted);
  }
  .lightbox-caption:empty {
    display: none;
  }
  /* The thumbnail buttons that open the window */
  .lightbox-trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: var(--border-width) solid var(--site-line);
    border-radius: var(--radius);
    background: var(--site-card);
    cursor: zoom-in;
    transition: border-color 150ms;
  }
  .lightbox-trigger:hover {
    border-color: var(--site-accent);
  }
  .lightbox-trigger img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const caption = document.getElementById('lightbox-caption');

  if (dialog && img && caption) {
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest<HTMLElement>('[data-lightbox-src]');
      if (trigger) {
        img.src = trigger.dataset.lightboxSrc ?? '';
        img.alt = trigger.dataset.lightboxAlt ?? '';
        caption.textContent = trigger.dataset.lightboxCaption ?? '';
        dialog.showModal();
        return;
      }
      // Close button, or a click on the dark area outside the image
      if (target.closest('[data-lightbox-close]') || target === dialog) {
        dialog.close();
      }
    });
    // Esc closes it automatically (built into <dialog>).
  }
</script>
