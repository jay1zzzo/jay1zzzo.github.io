---
// A grid of project cards for one category ("marketing" or "tool").
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard';

interface Props {
  category: 'marketing' | 'tool';
}
const { category } = Astro.props;
const projects = (await getCollection('projects', (p) => p.data.category === category)).sort(
  (a, b) => a.data.order - b.data.order,
);
---
<div class="grid gap-4 sm:grid-cols-2">
  {projects.map((p) => (
    <div class="rise-in">
      <ProjectCard
        client:visible
        label={p.data.label}
        title={p.data.title}
        summary={p.data.summary}
        href={`/projects/${p.id}`}
      />
    </div>
  ))}
</div>
