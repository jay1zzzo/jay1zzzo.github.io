---
// About me: a Short / Long switch.
// Short is the short intro. Long is the story from src/content/about.md, with its photos,
// the "What I've learned so far" list and a small "Outside of work" photo row.
// Both versions are on the page; a few lines of script show one at a time with a quick fade
// (no fade for visitors who prefer reduced motion). Needs <Lightbox /> on the same page.
import { getEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  short: string;
  reflectionsTitle?: string;
  reflections?: { title: string; text: string }[];
}
const { short, reflectionsTitle = "What I've learned so far", reflections = [] } = Astro.props;

const page = (await getEntry('pages', 'about'))!;
const paragraphs = (page.body ?? '').trim().split(/\n\s*\n/).map((b) => b.trim()).filter(Boolean);

const prep = async <T extends { src: ImageMetadata }>(list: T[] = []) =>
  Promise.all(list.map(async (p) => ({ ...p, large: await getImage({ src: p.src, width: 1600 }) })));
const photos = await prep(page.data.photos ?? []);
const outside = await prep(page.data.outside ?? []);
const portrait = (p: { src: ImageMetadata }) => p.src.height >= p.src.width;
---
<div class="about-switch" data-about-switch>
  <div class="switch-buttons" role="group" aria-label="Intro length">
    <button type="button" class="switch-btn" data-mode="short" aria-pressed="true">Short</button>
    <button type="button" class="switch-btn" data-mode="long" aria-pressed="false">Long</button>
  </div>

  <div class="switch-panel" data-panel="short" aria-live="polite">
    <p>{short}</p>
  </div>

  <div class="switch-panel story" data-panel="long" hidden>
    {paragraphs.map((para, i) => (
      <>
        <p>{para}</p>
        {photos.filter((p) => p.after === i + 1).map((p) => (
          <figure class={portrait(p) ? 'about-photo about-photo-portrait' : 'about-photo about-photo-landscape'}>
            <button
              type="button"
              class="lightbox-trigger"
              data-lightbox-src={p.large.src}
              data-lightbox-alt={p.alt}
              data-lightbox-caption={p.caption ?? ''}
              aria-label={`Enlarge photo: ${p.alt}`}
            >
              <Image src={p.src} alt={p.alt} width={portrait(p) ? 640 : 960} sizes="(min-width: 640px) 26rem, 90vw" loading="lazy" />
            </button>
            {p.caption && <figcaption>{p.caption}</figcaption>}
          </figure>
        ))}
      </>
    ))}

    {reflections.length > 0 && (
      <div class="reflections">
        <h3 class="label">{reflectionsTitle}</h3>
        <ol>
          {reflections.map((r, i) => (
            <li>
              <span class="ref-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <p class="ref-title">{r.title}</p>
                <p class="ref-text">{r.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    )}

    {outside.length > 0 && (
      <div class="outside">
        <h3 class="label">{page.data.outsideTitle ?? 'Outside of work'}</h3>
        <ul class="outside-row">
          {outside.map((p) => (
            <li>
              <button
                type="button"
                class="lightbox-trigger"
                data-lightbox-src={p.large.src}
                data-lightbox-alt={p.alt}
                data-lightbox-caption={p.caption ?? ''}
                aria-label={`Enlarge photo: ${p.alt}`}
              >
                <Image src={p.src} alt={p.alt} width={640} sizes="(min-width: 640px) 33vw, 100vw" loading="lazy" />
              </button>
              {p.caption && <p class="photo-caption">{p.caption}</p>}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</div>

<style>
  .about-switch {
    max-width: 48rem;
  }
  .switch-buttons {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .switch-btn {
    min-width: 6.5rem;
    padding: 0.5rem 1rem;
    font-family: var(--site-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--site-muted);
    background: transparent;
    border: 1px solid var(--site-line);
    border-radius: var(--radius);
    cursor: pointer;
    transition: color 150ms, border-color 150ms;
  }
  .switch-btn:hover {
    color: var(--site-text);
  }
  .switch-btn[aria-pressed='true'] {
    color: var(--site-accent);
    border-color: color-mix(in srgb, var(--site-accent) 70%, transparent);
  }
  @media (pointer: coarse) {
    .switch-btn {
      min-height: 2.75rem;
    }
  }
  .switch-panel {
    max-width: 65ch;
    color: var(--site-muted);
    transition: opacity 200ms ease, transform 200ms ease;
  }
  .switch-panel[hidden] {
    display: none;
  }
  .switch-panel.is-fading {
    opacity: 0;
    transform: translateY(4px);
  }
  .story > p {
    margin-bottom: 1rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .switch-panel {
      transition: none;
    }
  }

  /* Small photos: a fixed height, the width follows each photo's real proportions. */
  .about-photo {
    width: fit-content;
    max-width: 100%;
    margin: 0.25rem 0 1.5rem;
  }
  .about-photo :global(.lightbox-trigger),
  .outside-row :global(.lightbox-trigger) {
    display: block;
    width: auto;
  }
  .about-photo :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: 12rem;
  }
  .about-photo figcaption,
  .photo-caption {
    width: 0;
    min-width: 100%;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--site-muted);
  }

  .reflections {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--site-line);
  }
  .reflections ol {
    display: grid;
    gap: 1.25rem;
    margin-top: 1rem;
  }
  .reflections li {
    display: flex;
    gap: 1rem;
  }
  .ref-number {
    padding-top: 0.15rem;
    font-family: var(--site-mono);
    font-size: 0.75rem;
    color: var(--site-accent);
  }
  .ref-title {
    font-weight: 600;
    color: var(--site-text);
  }
  .ref-text {
    margin-top: 0.125rem;
    font-size: 0.9375rem;
  }

  .outside {
    margin-top: 2.5rem;
  }
  .outside-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1rem 1.25rem;
    margin-top: 1rem;
  }
  .outside-row li {
    width: fit-content;
    max-width: 100%;
  }
  .outside-row :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: 9rem;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-about-switch]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('.switch-btn');
    const panels = root.querySelectorAll<HTMLElement>('.switch-panel');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 'short';

    const show = (mode: string) => {
      panels.forEach((p) => {
        p.hidden = p.dataset.panel !== mode;
        p.classList.remove('is-fading');
      });
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
      current = mode;
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const mode = b.dataset.mode!;
        if (mode === current) return;
        (window as any).umami?.track?.('Intro toggle', { version: mode });
        const out = root.querySelector<HTMLElement>(`[data-panel="${current}"]`);
        if (reduce.matches || !out) {
          show(mode);
          return;
        }
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.mode === mode)));
        out.classList.add('is-fading');
        setTimeout(() => show(mode), 200);
      }),
    );
  });
</script>
